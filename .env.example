# Database provider (sqlite for dev, postgresql for Vercel)
DB_PROVIDER="postgresql"

# Database (PostgreSQL for Vercel)
# Create a Vercel Postgres database and copy the connection strings
DATABASE_URL="postgresql://user:password@host:port/dbname"
DIRECT_URL="postgresql://user:password@host:port/dbname"

# Email
EMAIL_SERVER="smtp://your-email:your-password@smtp.gmail.com:587"
EMAIL_FROM="your-email@gmail.com"
DIRECTRICE_EMAIL="director-email@example.com"

# Admin credentials
ADMIN_EMAIL="admin@dbageneve.com"
ADMIN_PASSWORD="your-secure-password"

# NextAuth
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-generated-secret-key-here"
NEXTAUTH_URL="https://your-vercel-domain.vercel.app"
